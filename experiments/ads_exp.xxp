workflow FireDetectionWorkflow {

    task DetectAlert {
        implementation "DetectAlert";
    }

    task SelectUsers {
        implementation "SelectUsers";
    }

    task UserResponse {
        implementation "UserResponse";
    }

    START -> DetectAlert -> SelectUsers -> UserResponse -> END;

    define input data ModelFile;
    define input data UsersInfo;

    configure data ModelFile {
        path "DetectAlert/**";
    }

    configure data UsersInfo {
        path "SelectUsers/**";
    }

    ModelFile --> DetectAlert.ModelFile;
    UsersInfo --> SelectUsers.UsersInfo;
}

workflow FireDetectionWorkflow1 from FireDetectionWorkflow {

}

experiment FireDetectionOptimizationExperiment {
    intent optimizeComputationTime;

    control {
        START -> S1 -> S2 -> S3 -> S4 -> S5 -> END;
    }

    // SPACE 1: Configuration de référence (baseline)
    space S1 of FireDetectionWorkflow1 {
        strategy randomsearch;
        runs = 3;

        // Paramètres optimaux par défaut (configuration de référence)
        param_values osrm_timeout_values = range(5, 5, 1);
        param_values euclidian_filter_values = range(20, 20, 1);
        param_values selection_diameter_values = range(10, 10, 1);
        param_values num_users_values = range(5, 5, 1);
        param_values user_profile_values = enum("driving");
        param_values filter_available_values = enum("true");
        param_values sort_by_values = enum("distance");

        task SelectUsers {
            param osrm_timeout_s = osrm_timeout_values;
            param euclidian_filter_km = euclidian_filter_values;
            param selection_diameter_km = selection_diameter_values;
            param num_users_selection = num_users_values;
            param user_profile_selection = user_profile_values;
            param filter_only_available = filter_available_values;
            param sort_by = sort_by_values;
        }

    }

    // SPACE 2: Optimisation du timeout OSRM
    space S2 of FireDetectionWorkflow1 {
        strategy randomsearch;
        runs = 6;

        param_values osrm_timeout_values = range(1, 15, 3);
        param_values euclidian_filter_values = range(20, 20, 1);
        param_values selection_diameter_values = range(10, 10, 1);
        param_values num_users_values = range(5, 5, 1);
        param_values user_profile_values = enum("driving");
        param_values filter_available_values = enum("true");
        param_values sort_by_values = enum("distance");

        task SelectUsers {
            param osrm_timeout_s = osrm_timeout_values;
            param euclidian_filter_km = euclidian_filter_values;
            param selection_diameter_km = selection_diameter_values;
            param num_users_selection = num_users_values;
            param user_profile_selection = user_profile_values;
            param filter_only_available = filter_available_values;
            param sort_by = sort_by_values;
        }

    }

    // SPACE 3: Optimisation du pré-filtrage euclidien
    space S3 of FireDetectionWorkflow1 {
        strategy randomsearch;
        runs = 8;

        param_values osrm_timeout_values = range(5, 5, 1);
        param_values euclidian_filter_values = range(5, 50, 10);
        param_values selection_diameter_values = range(10, 10, 1);
        param_values num_users_values = range(5, 5, 1);
        param_values user_profile_values = enum("driving");
        param_values filter_available_values = enum("true");
        param_values sort_by_values = enum("distance");

        task SelectUsers {
            param osrm_timeout_s = osrm_timeout_values;
            param euclidian_filter_km = euclidian_filter_values;
            param selection_diameter_km = selection_diameter_values;
            param num_users_selection = num_users_values;
            param user_profile_selection = user_profile_values;
            param filter_only_available = filter_available_values;
            param sort_by = sort_by_values;
        }

    }

    // SPACE 4: Optimisation du diamètre de sélection
    space S4 of FireDetectionWorkflow1 {
        strategy randomsearch;
        runs = 6;

        param_values osrm_timeout_values = range(5, 5, 1);
        param_values euclidian_filter_values = range(20, 20, 1);
        param_values selection_diameter_values = range(5, 30, 5);
        param_values num_users_values = range(5, 5, 1);
        param_values user_profile_values = enum("driving");
        param_values filter_available_values = enum("true");
        param_values sort_by_values = enum("distance");

        task SelectUsers {
            param osrm_timeout_s = osrm_timeout_values;
            param euclidian_filter_km = euclidian_filter_values;
            param selection_diameter_km = selection_diameter_values;
            param num_users_selection = num_users_values;
            param user_profile_selection = user_profile_values;
            param filter_only_available = filter_available_values;
            param sort_by = sort_by_values;
        }

    }

    // SPACE 5: Tests combinés (conditions optimales)
    space S5 of FireDetectionWorkflow1 {
        strategy randomsearch;
        runs = 10;

        param_values osrm_timeout_values = range(2, 10, 2);
        param_values euclidian_filter_values = range(10, 30, 5);
        param_values selection_diameter_values = range(8, 20, 3);
        param_values num_users_values = range(3, 8, 1);
        param_values user_profile_values = enum("driving");
        param_values filter_available_values = enum("true");
        param_values sort_by_values = enum("distance");

        task SelectUsers {
            param osrm_timeout_s = osrm_timeout_values;
            param euclidian_filter_km = euclidian_filter_values;
            param selection_diameter_km = selection_diameter_values;
            param num_users_selection = num_users_values;
            param user_profile_selection = user_profile_values;
            param filter_only_available = filter_available_values;
            param sort_by = sort_by_values;
        }

    }
}